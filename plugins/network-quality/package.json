{
  "name": "komari-plugin-network-quality",
  "version": "1.2.0",
  "private": true,
  "description": "Saved network routing and service availability reports for Komari",
  "license": "AGPL-3.0-only",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "komari-plugin-dev check",
