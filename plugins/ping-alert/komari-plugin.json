{
  "$schema": "./node_modules/@komari-monitor/plugin-sdk/schema/komari-plugin.schema.json",
  "name": {
    "zh-CN": "Ping 告警与报告",
    "en": "Ping Alerts and Reports"
  },
  "short": "ping-alert",
  "icon": "assets/ping-alert-icon.svg",
  "komari": ">=1.6.1",
  "description": {
    "zh-CN": "探测/丢包检测按需报告；中文通知排版、模板预览与模拟发送，支持日/周/月及自定义报告。",
    "en": "Selective probe/loss reporting with notification preview and simulation."
  },
  "version": "1.2.0",
  "entry": "script.js",
  "author": "pickarm",
  "url": "https://github.com/pickarm/komari-plugins",
  "permissions": {
    "node": true,
    "allowSystemRPC": true,
    "timeout": 60,
    "allowRoutes": true,
    "maxHTTPBodyBytes": 32768
  },
  "configuration": {
    "type": "managed",
    "data": [
      {
        "key": "enabled",
        "name": {
          "zh-CN": "启用探测检测",
          "en": "Enable probe detection"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "控制超时/延迟检测。关闭后不再报告延迟，丢包率检测可独立开启；两项均关闭时不生成任何报告。"
        }
      },
      {
        "key": "all_tasks",
        "name": {
          "zh-CN": "全部 Ping 任务",
          "en": "All Ping tasks"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "关闭后仅监控所选任务。"
        }
      },
      {
        "key": "ping_tasks",
        "name": {
          "zh-CN": "选择任务",
          "en": "Selected tasks"
        },
        "type": "pingtasks",
        "default": "[]"
      },
      {
        "key": "all_nodes",
        "name": {
          "zh-CN": "任务内全部节点",
          "en": "All task nodes"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "关闭后仅监控所选节点。"
        }
      },
      {
        "key": "nodes",
        "name": {
          "zh-CN": "选择节点",
          "en": "Selected nodes"
        },
        "type": "nodes",
        "default": "[]"
      },
      {
        "key": "failure_threshold",
        "name": {
          "zh-CN": "连续异常探测次数",
          "en": "Consecutive failed probes"
        },
        "type": "number",
        "default": 10,
        "help": {
          "zh-CN": "默认 10 次，范围 1–1000；按实际探测结果计数，超时或开启延迟检测后的延迟超限均为异常。"
        }
      },
      {
        "key": "recovery_threshold",
        "name": {
          "zh-CN": "连续恢复探测次数",
          "en": "Consecutive healthy probes"
        },
        "type": "number",
        "default": 2,
        "help": {
          "zh-CN": "范围 1–1000；开启延迟检测后，须连续满足恢复延迟。"
        }
      },
      {
        "key": "latency_enabled",
        "name": {
          "zh-CN": "启用延迟阈值检测",
          "en": "Enable latency thresholds"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "关闭时只判断超时/失败。开启后同时判断下面的延迟阈值。"
        }
      },
      {
        "key": "failure_latency_ms",
        "name": {
          "zh-CN": "异常延迟：大于多少毫秒",
          "en": "Failure latency above (ms)"
        },
        "type": "number",
        "default": 200,
        "help": {
          "zh-CN": "仅延迟检测开启时生效，范围 0.001–600000 ms。"
        }
      },
      {
        "key": "recovery_latency_ms",
        "name": {
          "zh-CN": "恢复延迟：不高于多少毫秒",
          "en": "Recovery latency at most (ms)"
        },
        "type": "number",
        "default": 150,
        "help": {
          "zh-CN": "范围 0–600000 ms；不能高于异常阈值，超过时自动限制。两阈值之间既不累计异常，也不累计恢复。"
        }
      },
      {
        "key": "loss_enabled",
        "name": {
          "zh-CN": "启用丢包率检测",
          "en": "Enable packet-loss detection"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "独立开关。关闭后所有默认通知和报告均不展示丢包率；缺报不当作丢包。"
        }
      },
      {
        "key": "loss_window_probes",
        "name": {
          "zh-CN": "丢包率统计：最近多少次探测",
          "en": "Packet-loss window (probes)"
        },
        "type": "number",
        "default": 20,
        "help": {
          "zh-CN": "范围 2–1000。收集满 N 次新探测后开始判断，每增加一次探测更新窗口。"
        }
      },
      {
        "key": "loss_failure_percent",
        "name": {
          "zh-CN": "丢包率告警：达到多少百分比",
          "en": "Loss alert threshold (%)"
        },
        "type": "number",
        "default": 20,
        "help": {
          "zh-CN": "范围 0.001–100，丢包率达到此值时累计异常。"
        }
      },
      {
        "key": "loss_recovery_percent",
        "name": {
          "zh-CN": "丢包率恢复：不高于多少百分比",
          "en": "Loss recovery threshold (%)"
        },
        "type": "number",
        "default": 5,
        "help": {
          "zh-CN": "范围 0–100，不能高于告警值；恢复还必须低于告警值。"
        }
      },
      {
        "key": "loss_failure_probes",
        "name": {
          "zh-CN": "连续丢包超限探测次数",
          "en": "Consecutive loss breaches"
        },
        "type": "number",
        "default": 1,
        "help": {
          "zh-CN": "窗口收集满后，连续多少次新探测的窗口丢包率超限才通知；范围 1–1000。"
        }
      },
      {
        "key": "loss_recovery_probes",
        "name": {
          "zh-CN": "连续丢包恢复探测次数",
          "en": "Consecutive loss recoveries"
        },
        "type": "number",
        "default": 2,
        "help": {
          "zh-CN": "范围 1–1000；达到后发送一次丢包恢复通知。"
        }
      },
      {
        "key": "notify_recovery",
        "name": {
          "zh-CN": "发送恢复通知",
          "en": "Send recovery notifications"
        },
        "type": "switch",
        "default": true,
        "help": {
          "zh-CN": "同时适用于探测异常与丢包率告警。"
        }
      },
      {
        "key": "failure_template",
        "name": {
          "zh-CN": "故障通知模板",
          "en": "Failure template"
        },
        "type": "richtext",
        "default": "",
        "help": {
          "zh-CN": "留空使用中文默认消息。支持 {{task}} {{task_id}} {{node}} {{uuid}} {{target}} {{count}} {{latency}} {{loss}} {{time}} {{event}} {{message}}。"
        }
      },
      {
        "key": "recovery_template",
        "name": {
          "zh-CN": "恢复通知模板",
          "en": "Recovery template"
        },
        "type": "richtext",
        "default": "",
        "help": {
          "zh-CN": "支持与故障模板相同的占位符。"
        }
      },
      {
        "key": "daily_enabled",
        "name": {
          "zh-CN": "启用日报",
          "en": "Enable daily report"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "统计上一个完整自然日。"
        }
      },
      {
        "key": "daily_cron",
        "name": {
          "zh-CN": "日报发送计划",
          "en": "Daily schedule"
        },
        "type": "string",
        "default": "0 9 * * *",
        "help": {
          "zh-CN": "按 Komari 服务端时区。默认每天 09:00，cron：分 时 日 月 周。"
        }
      },
      {
        "key": "weekly_enabled",
        "name": {
          "zh-CN": "启用周报",
          "en": "Enable weekly report"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "统计上一个完整自然周（周一至周一）。"
        }
      },
      {
        "key": "weekly_cron",
        "name": {
          "zh-CN": "周报发送计划",
          "en": "Weekly schedule"
        },
        "type": "string",
        "default": "0 9 * * 1",
        "help": {
          "zh-CN": "按服务端时区，默认周一 09:00。"
        }
      },
      {
        "key": "monthly_enabled",
        "name": {
          "zh-CN": "启用月报",
          "en": "Enable monthly report"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "统计上一个完整自然月。"
        }
      },
      {
        "key": "monthly_cron",
        "name": {
          "zh-CN": "月报发送计划",
          "en": "Monthly schedule"
        },
        "type": "string",
        "default": "0 9 1 * *",
        "help": {
          "zh-CN": "按服务端时区，默认每月 1 日 09:00。"
        }
      },
      {
        "key": "custom_enabled",
        "name": {
          "zh-CN": "启用自定义报告",
          "en": "Enable custom report"
        },
        "type": "switch",
        "default": false,
        "help": {
          "zh-CN": "按下面的计划发送最近指定小时数的报告。"
        }
      },
      {
        "key": "custom_cron",
        "name": {
          "zh-CN": "自定义发送计划",
          "en": "Custom schedule"
        },
        "type": "string",
        "default": "0 */6 * * *",
        "help": {
          "zh-CN": "按服务端时区。例如 30 20 * * * 为每天 20:30；@every 2h 为每两小时。"
        }
      },
      {
        "key": "custom_hours",
        "name": {
          "zh-CN": "自定义报告统计多少小时",
          "en": "Custom report span (hours)"
        },
        "type": "number",
        "default": 6,
        "help": {
          "zh-CN": "范围 0.05–8760；支持小数，例如 0.5 表示最近 30 分钟。"
        }
      },
      {
        "key": "report_template",
        "name": {
          "zh-CN": "报告通知模板",
          "en": "Report template"
        },
        "type": "richtext",
        "default": "",
        "help": {
          "zh-CN": "留空仅显示已开启检测项。支持 {{start}} {{end}} {{latency}} {{loss}} {{nodes}} {{count}} {{event}} {{event_code}} {{message}}。关闭项的占位符返回空；自定义文字由你自行决定。"
        }
      },
      {
        "key": "notice_utc_offset",
        "name": {
          "zh-CN": "通知时间时区（UTC 偏移）",
          "en": "Notification UTC offset"
        },
        "type": "number",
        "default": 8,
        "help": {
          "zh-CN": "默认 UTC+8，范围 -12 至 14。仅控制插件通知中的时间，报告调度仍使用服务器时区，全局模板的时间由 Komari 决定。"
        }
      }
    ]
  },
  "pages": [
    {
      "file": "pages/test.html",
      "title": {
        "zh-CN": "通知模拟与模板测试",
        "en": "Notification Simulator"
      },
      "visibility": "admin",
      "type": "iframe"
    }
  ]
}
